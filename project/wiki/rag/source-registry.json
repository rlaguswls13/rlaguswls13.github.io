        { "path": "project/wiki/index.md", "type": "file", "extensions": [".md"] },
        { "path": "project/wiki/agent-harness-rules.md", "type": "file", "extensions": [".md"] },
        { "path": "project/wiki/agent-memory.md", "type": "file", "extensions": [".md"] },
