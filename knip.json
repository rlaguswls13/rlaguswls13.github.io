{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "next": true,
  "entry": [
    "src/app/**/{page,layout,route,error,loading,not-found,default,template,global-error}.{ts,tsx}",
    "next.config.{js,mjs,ts}",
    "playwright.config.ts",
    "vitest.config.{js,ts,mjs,mts}",
    "scripts/**/*.{mjs,mts}",
    "tests/**/*.{ts,tsx,mjs,mts}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "tests/**/*.{ts,tsx,mjs,mts}"
  ],
  "ignore": [
    "src/content/**"
  ]
}
